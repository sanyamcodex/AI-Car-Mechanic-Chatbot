{
  "info": {
    "name": "AI Car Mechanic Assistant API",
    "description": "Postman Collection for testing all virtual mechanic endpoints, diagnostic flows, media uploads, and appointment booking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "<BACKEND_URL>",
      "type": "string"
    },
    {
      "key": "conversation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "diagnosis_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "upload_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "booking_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health/",
            "description": "Verifies service availability and database connectivity."
          }
        },
        {
          "name": "Stats & Telemetry",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/stats/",
            "description": "Retrieves usage counts, AI call ratio, and media purpose breakdown."
          }
        }
      ]
    },
    {
      "name": "Chat & Triage",
      "item": [
        {
          "name": "Send Chat Message",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/chat/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"My brakes are making a loud grinding squeak when I press the pedal\",\n  \"client_msg_id\": \"cm-test-01\"\n}"
            }
          }
        },
        {
          "name": "Select Choice Chip",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/chat/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"choice\": {\n    \"question_id\": \"intake\",\n    \"option_id\": \"brake_squeal\"\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Conversations & History",
      "item": [
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/conversations/"
          }
        },
        {
          "name": "Get Conversation Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/conversations/{{conversation_id}}/"
          }
        }
      ]
    },
    {
      "name": "Diagnosis Assessment",
      "item": [
        {
          "name": "Request Assessment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diagnosis/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"force\": true\n}"
            }
          }
        },
        {
          "name": "Get Diagnosis Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/diagnosis/{{diagnosis_id}}/"
          }
        }
      ]
    },
    {
      "name": "Media Uploads",
      "item": [
        {
          "name": "Upload Media File",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/uploads/",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        },
        {
          "name": "Get Upload Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/uploads/{{upload_id}}/"
          }
        }
      ]
    },
    {
      "name": "Mechanic Booking",
      "item": [
        {
          "name": "Create Appointment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/booking/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "idem-key-sample-123"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Rajesh Sharma\",\n  \"phone\": \"9812345670\",\n  \"city\": \"Meerut\",\n  \"scheduled_at\": \"2026-09-25T10:00:00Z\",\n  \"service_key\": \"brake_service\",\n  \"conversation_id\": \"{{conversation_id}}\"\n}"
            }
          }
        },
        {
          "name": "Get Booking Receipt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/booking/{{booking_id}}/"
          }
        }
      ]
    }
  ]
}
